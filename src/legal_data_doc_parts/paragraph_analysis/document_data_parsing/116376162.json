  "result": {
    "components": [
      {
        "id": "P01",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "маючи умисел на незаконне придбання, виготовлення та зберігання наркотичних засобів, без мети збуту,",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P02",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "в один із днів серпня 2023 року,",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P03",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "перебуваючи на території огородньої ділянки розташованої за адресою: АДРЕСА_1 , нарвав, тобто незаконно придбав рослини коноплі,",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P04",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "потім переніс їх до побутового приміщення будинку домоволодіння, розташованого за вищевказаною адресою,",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P05",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "де незаконно, не маючи на те відповідного дозволу, висушив та подрібнив їх,",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P06",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "тим самим виготовив відповідно до висновку експерта № СЕ-19/119-23/16388 від 16.11.2023 особливо небезпечний наркотичний засіб - канабіс,",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Докази та експертні висновки",
        "support_status": null
      },
      {
        "id": "P07",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "частину якого вжив особисто шляхом паління за допомогою саморобних пристроїв,",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P08",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "а залишок канабісу почав зберігати в аптечці, розділивши на 6 частин,",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P09",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "одну частину у згортку з аркуша паперу з друкованим написом «На обширных пространствах…», масою в перерахунку на суху речовину 0,982 грам,",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P10",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "одну частину у згортку з двох аркушів газетного паперу з друкованим написом «КОПИЛКА…», масою у перерахунку на суху речовину 16,23 грам,",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P11",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "одну частину у пакеті із прозорого полімерного матеріалу білого кольору, масою у перерахунку на суху речовину 75,88 грам,",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P12",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "одну частину в ємності циліндричної форми довжиною 14,3 см., масою у перерахунку на суху речовину 8,87 грам,",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P13",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "одну частину в пакеті з застібкою zip-lock з паперовою наліпкою з написом «ХОМУТ ЧЕРВ`ЯЧНИЙ…», масою у перерахунку на суху речовину 10,49 грам,",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P14",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "одну частину у згортку з фрагменту з аркуша паперу з друкованим написом «ПУМБ…», масою у перерахунку на суху речовину 4,93 грам, яка знаходилась в спальній кімнаті будинку.",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P15",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Загальна маса канабісу в перерахунку на суху речовину склала 117,382 грам,",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Докази та експертні висновки",
        "support_status": null
      },
      {
        "id": "P16",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "який ОСОБА_5  незаконно, не маючи на те відповідного дозволу, зберігав в аптечці в спальній кімнаті будинку свого домоволодіння за вищевказаною адресою, без мети збуту,",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P17",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "до 09 листопада 2023 року, коли в період часу з 10 год. 40 хв. по 11 год. 48 хв. при проведенні обшуку вказаний особливо небезпечний наркотичний засіб - канабіс було виявлено та вилучено співробітниками поліції.",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Процесуальні дії та вилучення",
        "support_status": null
      },
      {
        "id": "P18",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "незаконно, не маючи на те відповідного дозволу,",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P19",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "17 січня 2024 року між прокурором Богодухівської окружної прокуратури Харківської області ОСОБА_3 , якому на підставі ст.37 КПК України надані повноваження прокурора у даному кримінальному провадженні та ОСОБА_5 , в присутності захисника - адвоката ОСОБА_4 , в порядку, передбаченому ст.ст. 468, 469,470 та 472 КПК України, укладено угоду про визнання винуватості.",
          "paragraph_id": 16,
          "start_char": null,
          "end_char": null
        },
        "section": "Угода про визнання винуватості",
        "support_status": null
      },
      {
        "id": "P20",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Згідно з даною угодою прокурор та обвинувачений ОСОБА_5 дійшли згоди щодо формулювання підозри, всіх істотних для даного кримінального провадження обставин та правової кваліфікації дій обвинуваченого за ч.1 ст.309 КК України,",
          "paragraph_id": 17,
          "start_char": null,
          "end_char": null
        },
        "section": "Угода про визнання винуватості",
        "support_status": null
      },
      {
        "id": "P21",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "обвинувачений ОСОБА_5 у повному обсязі сформульованої підозри беззастережно визнав свою винуватість у вчиненні даного кримінального правопорушення.",
          "paragraph_id": 17,
          "start_char": null,
          "end_char": null
        },
        "section": "Угода про визнання винуватості",
        "support_status": null
      },
      {
        "id": "P22",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Також сторонами угоди визначено узгоджене ними покарання, яке ОСОБА_5 має понести за вчинення кримінального правопорушення передбаченого ч.1 ст.309 КК України у виді обмеження волі строком на 1 рік, із звільненням від відбування призначеного покарання з іспитовим строком на підставі ст.75 КК України, строк якого визначить суд та покладенням обов`язків, передбачених ст.76 КК України, які визначить суд.",
          "paragraph_id": 17,
          "start_char": null,
          "end_char": null
        },
        "section": "Узгоджене покарання",
        "support_status": null
      },
      {
        "id": "P23",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Відповідно до правил ст.ст. 468, 469 КПК України у кримінальному провадженні щодо кримінальних проступків, нетяжких злочинів, тяжких злочинів, може бути укладена угода між прокурором та підозрюваним чи обвинуваченим про визнання винуватості.",
          "paragraph_id": 19,
          "start_char": null,
          "end_char": null
        },
        "section": "Правові норми КПК",
        "support_status": null
      },
      {
        "id": "P24",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Прокурор під час судового засідання вважаючи, що при укладенні даної угоди дотримані вимоги і правила КПК України та КК України, просив угоду затвердити і призначити обвинуваченому узгоджену в ній міру покарання.",
          "paragraph_id": 20,
          "start_char": null,
          "end_char": null
        },
        "section": "Позиції сторін",
        "support_status": null
      },
      {
        "id": "P25",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Обвинувачений ОСОБА_5 та його захисник - адвокат ОСОБА_4 в судовому засіданні також просили затвердити угоду про визнання винуватості і призначити узгоджену в ній міру покарання,",
          "paragraph_id": 21,
          "start_char": null,
          "end_char": null
        },
        "section": "Позиції сторін",
        "support_status": null
      },
      {
        "id": "P26",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "при цьому обвинувачений ОСОБА_5 беззастережно визнав себе винуватим у вчиненні кримінального правопорушення, передбаченого ч. 1 ст. 309 КК України, за обставин, як вони викладені в обвинувальному акті.",
          "paragraph_id": 21,
          "start_char": null,
          "end_char": null
        },
        "section": "Позиції сторін",
        "support_status": null
      },
      {
        "id": "P27",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Кримінальне правопорушення, передбачене ч.1 ст.309 КК України згідно зі ст. 12 КК України є кримінальним проступком, потерпілий у провадженні відсутній.",
          "paragraph_id": 23,
          "start_char": null,
          "end_char": null
        },
        "section": "Правова характеристика правопорушення",
        "support_status": null
      },
      {
        "id": "P28",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Суд, заслухавши пояснення сторін кримінального провадження, переконався, що укладення угоди сторонами є добровільним, при цьому судом встановлено, що ОСОБА_5 повністю усвідомлює зміст угоди про визнання винуватості, характер обвинувачення, щодо якого визнає себе винним, цілком розуміє свої права, визначені п.1 ч.4 ст.474 КПК України, а також наслідки укладення, затвердження даної угоди, передбачені ч.2 ст.473 КПК України, та наслідки її не виконання, передбачені ст. 476 КПК України.",
          "paragraph_id": 24,
          "start_char": null,
          "end_char": null
        },
        "section": "Перевірка добровільності та усвідомленості угоди",
        "support_status": null
      },
      {
        "id": "P29",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Покарання сторонами угоди визначено у відповідності до положень ст. ст. 50, 65-67 КК України, з урахуванням характеру та тяжкості висунутого ОСОБА_5 обвинувачення, даних про його особу, обставин, що пом`якшують покарання у виді щирого каяття та активного сприяння розкриттю кримінального правопорушення, відсутність обставин, що обтяжують покарання.",
          "paragraph_id": 25,
          "start_char": null,
          "end_char": null
        },
        "section": "Мотиви призначення узгодженого покарання",
        "support_status": null
      },
      {
        "id": "P30",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Керуючись ст. ст. 373, 374, 468, 469,472, 475 КПК України суд, -",
          "paragraph_id": 30,
          "start_char": null,
          "end_char": null
        },
        "section": "Застосовані норми КПК",
        "support_status": null
      },
      {
        "id": "C01",
        "type": "CLAIM",
        "argumentative_role": "INTERMEDIATE_CONCLUSION",
        "source_span": {
          "text": "Дії ОСОБА_5 кваліфіковані за ч.1 ст.309 КК України, тобто незаконне придбання, виготовлення та зберігання наркотичного засобу без мети збуту.",
          "paragraph_id": 15,
          "start_char": null,
          "end_char": null
        },
        "section": "Правова кваліфікація",
        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "C02",
        "type": "CLAIM",
        "argumentative_role": "INTERMEDIATE_CONCLUSION",
        "source_span": {
          "text": "Таким чином, суд вважає, що обставини вчинення ОСОБА_5 кримінального правопорушення, передбаченого ч.1 ст.309 КК України знайшли своє підтвердження під час судового засідання.",
          "paragraph_id": 22,
          "start_char": null,
          "end_char": null
        },
        "section": "Оцінка суду",
        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "C03",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "Враховуючи викладене, оскільки умови угоди про визнання винуватості між прокурором та обвинуваченим ОСОБА_5 відповідають вимогам КПК України та КК України, суд дійшов висновку про наявність правових підстав для її затвердження.",
          "paragraph_id": 26,
          "start_char": null,
          "end_char": null
        },
        "section": "Висновки суду щодо затвердження угоди",
        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "C04",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "Міра запобіжного заходу обвинуваченому ОСОБА_5 не обиралась.",
          "paragraph_id": 27,
          "start_char": null,
          "end_char": null
        },
        "section": "Запобіжний захід",
        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "C05",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "Питання щодо речових доказів вирішити відповідно до ст.100 КПК України.",
          "paragraph_id": 28,
          "start_char": null,
          "end_char": null
        },
        "section": "Речові докази",
        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "C06",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "Документально підтверджені судові витрати, відповідно до ст.124 КПК України, необхідно стягнути з обвинуваченого.",
          "paragraph_id": 29,
          "start_char": null,
          "end_char": null
        },
        "section": "Судові витрати",
        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "P31",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Керуючись ст. ст. 373, 374, 468, 469,472, 475 КПК України суд, -",
          "paragraph_id": 30,
          "start_char": null,
          "end_char": null
        },
        "section": "Нормативне обґрунтування (КПК)",
        "support_status": null
      },
      {
        "id": "P32",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "відповідно до ст.100 КПК України",
          "paragraph_id": 28,
          "start_char": null,
          "end_char": null
