      {
        "id": "P01",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "13 грудня 2023 року, приблизно о 20 год 00 хв, ОСОБА_4 , знаходячись у приміщенні супермаркету «Варус-11», розташованому за адресою: м.Дніпро, бульвар Європейській, буд.1Д,",
          "paragraph_id": 17,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P02",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "достовірно знаючи, що на всій території України 24.02.2022 указом Президента України №64/2022 введено воєнний стан, який продовжено,",
          "paragraph_id": 17,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P03",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "реалізуючи раптово виниклий умисел на таємне викрадення чужого майна",
          "paragraph_id": 17,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P04",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "скориставшись тим, що за його діями ніхто не спостерігає, діючи таємно, з корисливих мотивів",
          "paragraph_id": 17,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P05",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "в умовах воєнного стану, шляхом вільного доступу, викрав майно ТОВ „Омега\", а саме:",
          "paragraph_id": 17,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P06",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "-коньяк ВС «Хеннесі», об`ємом 0,5 л, 40%, в кількості 1 шт, вартістю 983 грн 83 коп;",
          "paragraph_id": 18,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини (перелік викраденого)",
        "support_status": null
      },
      {
        "id": "P07",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "-пиво зі смаком «Spritz & More Garage», об`ємом 0,5 л, з/б, у кількості 1 шт, вартістю 41 грн 03 коп, а всього на загальну суму 1024 грн 86 коп, чим спричинив ТОВ «Омега» матеріальний збиток на вказану суму.",
          "paragraph_id": 19,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини (перелік викраденого та шкода)",
        "support_status": null
      },
      {
        "id": "P08",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "виконавши усі дії, які він вважав необхідним для доведення злочину до кінця",
          "paragraph_id": 20,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини (ознаки закінченого замаху)",
        "support_status": null
      },
      {
        "id": "P09",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "намагався покинути місце скоєння кримінального правопорушення",
          "paragraph_id": 20,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини (поведінка після викрадення)",
        "support_status": null
      },
      {
        "id": "P10",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "однак, довести до кінця свій злочинний умисел та розпорядитися викраденим товаром не зміг, з причин, що не залежали від його волі",
          "paragraph_id": 20,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини (ознаки закінченого замаху)",
        "support_status": null
      },
      {
        "id": "P11",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "так як був затриманий співробітниками магазину при виході з магазину.",
          "paragraph_id": 20,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини (затримання працівниками магазину)",
