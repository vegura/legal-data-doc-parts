        "section": "Пояснення обвинуваченого",
        "support_status": null
      },
      {
        "id": "P17",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Товар він повернув.",
          "paragraph_id": 23,
