      {
        "id": "P16",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "взяв пляшку коньяку та пива, сховав їх під куртку і пішов на вихід з магазину, де його затримала охорона.",
