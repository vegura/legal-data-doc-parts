      {
        "id": "C04",
        "type": "CLAIM",
        "argumentative_role": "INTERMEDIATE_CONCLUSION",
        "source_span": {
          "text": "застосування більшого розміру покарання або ізоляції від суспільства, за конкретних обставин справи і поведінки обвинуваченого в даному випадку є явно не справедливим",
