      },
      {
        "id": "P13",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Згідно до ст. 337 КПК України суд діє лише в межах висунутого обвинувачення.",
          "paragraph_id": 20,
          "start_char": null,
          "end_char": null
        },
        "section": "Процесуальні межі розгляду",
        "support_status": null
      },
      {
        "id": "C01",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "Суд кваліфікує дії обвинуваченого ОСОБА_4 за викладеним фактом за ч. 4 ст. 185 КК України, як таємне викрадення чужого майна (крадіжка), поєднане з проникненням до іншого приміщення, вчинене в умовах воєнного стану.",
          "paragraph_id": 21,
          "start_char": null,
