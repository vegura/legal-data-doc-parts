      },
      {
        "id": "P21",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "встановленої ст. 50 КК України його мети не тільки кари, а й виправлення і запобігання вчиненню винними та іншими особами нових злочинів",
