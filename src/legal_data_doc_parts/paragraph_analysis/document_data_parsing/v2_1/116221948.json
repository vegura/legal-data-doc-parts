      {
        "id": "P30",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Показання обвинуваченого ОСОБА_5 є послідовними, логічними та відповідають фактичним обставинам справи",
          "paragraph_id": 19,
          "start_char": null,
          "end_char": null
        },
        "section": "Оцінка доказів",
