      },
      {
        "id": "P19",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Один мішок був розірваний і коли приїхали працівники поліції та вилучили викрадене, він купив один цілий мішок і повернув власнику.",
          "paragraph_id": 17,
          "start_char": null,
          "end_char": null
        },
        "section": "Пояснення обвинуваченого",
        "support_status": null
      },
      {
        "id": "P20",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "У скоєному щиро кається",
