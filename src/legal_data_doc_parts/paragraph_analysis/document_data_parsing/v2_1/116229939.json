      },
      {
        "id": "P14",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "винним себе визнав повністю",
          "paragraph_id": 17,
          "start_char": null,
          "end_char": null
        },
        "section": "Пояснення обвинуваченого",
        "support_status": null
      },
      {
        "id": "P15",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "через незамкнену хвіртку проник на територію домогосподарства потерпілого, що розташоване в АДРЕСА_2 ,",
