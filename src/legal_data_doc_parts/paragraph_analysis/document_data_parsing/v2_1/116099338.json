    "components": [
      {
        "id": "P01",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "15.07.2023, приблизно о 20:00 год, перебуваючи  у м. Львові на вул. Полуничній, під час прогулянки на території садового кооперативу «Золотий ранет»",
          "paragraph_id": 13,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P02",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "маючи умисел на незаконне придбання та зберігання наркотичних засобів",
          "paragraph_id": 13,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P03",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "у порушення вимог Закону України «Про наркотичні засоби, психотропні речовини і прекурсори» від 15 лютого 1995 року",
          "paragraph_id": 13,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини (нормативна підстава)",
        "support_status": null
      },
      {
        "id": "P04",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "на узбіччі стежки, біля одного із дерев, придбав (знайшов) полімерний пакет із порошкоподібною речовиною білого кольору.",
          "paragraph_id": 13,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P05",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "усвідомлюючи, що у вказаному полімерному пакеті знаходиться психотропна речовина",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P06",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "залишив його при собі з метою власного вживання, без мети збуту",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P07",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "в котрій згідно висновку експертизи наркотичних засобів, психотропних речовин, їх аналогів та прекурсорів №CЕ-19/114-23/14081-НЗПРАП від 06.09.2023 виявлено PVP, що відноситься до особливо небезпечних психотропних речовин, обіг яких обмежено, масою    0,3388 грам.",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Докази (висновок експерта)",
        "support_status": null
      },
      {
        "id": "P08",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "у порушення вимог Закону України «Про наркотичні засоби, психотропні речовини і прекурсори» від 15 лютого 1995 року",
          "paragraph_id": 15,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини (нормативна підстава)",
        "support_status": null
      },
      {
        "id": "P09",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "15.07.2023, приблизно о 20:15 год, ОСОБА_3 , перебуваючи на вул.Полуничній у м. Львові був зупинений працівниками ТОР УПП у Львівській області ДПП",
          "paragraph_id": 15,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P10",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "повідомив про те, що зберігає при собі полімерний пакет з порошкоподібною речовиною білого кольору",
          "paragraph_id": 15,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P11",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "у період часу з 21:27 год по 21:31 год, добровільно під час огляду місця події видав працівникам поліції",
          "paragraph_id": 15,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P12",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "зберігав зазначену психотропну речовину для власного вживання без мети збуту",
          "paragraph_id": 15,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P13",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Таким чином, ОСОБА_3 обвинувачується у незаконному придбанні та зберіганні психотропної речовини без мети збуту, тобто у вчиненні кримінального проступку, передбаченого ч.1 ст. 309 КК України.",
          "paragraph_id": 16,
          "start_char": null,
          "end_char": null
        },
        "section": "Формулювання обвинувачення",
        "support_status": null
      },
      {
        "id": "P14",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Обвинувачений ОСОБА_3 повністю і беззаперечно визнав свою винуватість у вчиненні кримінального проступку, передбаченого ч.1 ст.309 КК України,",
          "paragraph_id": 17,
          "start_char": null,
          "end_char": null
        },
        "section": "Позиція обвинуваченого",
        "support_status": null
      },
      {
        "id": "P15",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "не оспорював встановлені органом досудового слідства обставини",
          "paragraph_id": 17,
          "start_char": null,
          "end_char": null
        },
        "section": "Позиція обвинуваченого",
        "support_status": null
      },
      {
        "id": "P16",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "надав згоду на розгляд обвинувального акта в порядку спрощеного провадження без його участі, ознайомлений з обмеженням права апеляційного оскарження.",
          "paragraph_id": 17,
          "start_char": null,
          "end_char": null
        },
        "section": "Процесуальні гарантії та позиція обвинуваченого",
        "support_status": null
      },
      {
        "id": "P17",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Така заява ОСОБА_3 складена в присутності адвоката ОСОБА_4 .",
          "paragraph_id": 17,
          "start_char": null,
          "end_char": null
        },
        "section": "Процесуальні гарантії",
        "support_status": null
      },
      {
        "id": "P18",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "у відповідності до приписів ч.2 ст.381, ч.3 ст.382 КПК України",
          "paragraph_id": 18,
          "start_char": null,
          "end_char": null
        },
        "section": "Процесуальні підстави розгляду",
        "support_status": null
      },
      {
        "id": "P19",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "погодився на призначене покарання у виді штрафу у розмірі 17000 грн.",
          "paragraph_id": 19,
          "start_char": null,
          "end_char": null
        },
        "section": "Пояснення обвинуваченого щодо покарання",
        "support_status": null
      },
      {
        "id": "P20",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "обставини змінилися, він офіційно не працевлаштований, стабільного доходу немає, мама  також є пенсійного віку, отже в нього відсутні будь які доходи за які він міг би сплатити штраф як покарання за проступок.",
          "paragraph_id": 19,
          "start_char": null,
          "end_char": null
        },
        "section": "Пояснення обвинуваченого щодо покарання",
        "support_status": null
      },
      {
        "id": "P21",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Погоджується на призначення покарання у виді обмеження волі із застосуванням ст.75 та 76 КК України.",
          "paragraph_id": 19,
          "start_char": null,
          "end_char": null
        },
        "section": "Пояснення обвинуваченого щодо покарання",
        "support_status": null
      },
      {
        "id": "P22",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Прокурор в судовому засіданні визнав мотиви обвинуваченого щодо його платоспроможності як такими, що немає можливості для оплати штрафу",
          "paragraph_id": 20,
          "start_char": null,
          "end_char": null
        },
        "section": "Позиція прокурора щодо покарання",
        "support_status": null
      },
      {
        "id": "P23",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "погодилася на призанення обвинуваченому покарання у виді 1 року обмеження волі із застосуванням ст.75,76 КК України.",
          "paragraph_id": 20,
          "start_char": null,
          "end_char": null
        },
        "section": "Позиція прокурора щодо покарання",
        "support_status": null
      },
      {
        "id": "P24",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "що стверджується зібраними доказами.",
          "paragraph_id": 21,
          "start_char": null,
          "end_char": null
        },
        "section": "Оцінка доказів",
        "support_status": null
      },
      {
        "id": "P25",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "враховуючи ступінь тяжкості вчиненого кримінального правопорушення, який відноситься до категорії проступків",
          "paragraph_id": 22,
          "start_char": null,
          "end_char": null
        },
        "section": "Мотиви призначення покарання",
        "support_status": null
      },
      {
        "id": "P26",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "вчинений умисно з корисливих мотивів",
          "paragraph_id": 22,
          "start_char": null,
          "end_char": null
        },
        "section": "Мотиви призначення покарання",
        "support_status": null
      },
      {
        "id": "P27",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "який раніше не  судимий,",
          "paragraph_id": 22,
          "start_char": null,
          "end_char": null
        },
        "section": "Мотиви призначення покарання (дані про особу)",
        "support_status": null
      },
      {
        "id": "P28",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "визнав повністю свою вину та розкаявся у вчиненому кримінальному проступку,",
          "paragraph_id": 22,
          "start_char": null,
          "end_char": null
        },
        "section": "Мотиви призначення покарання (поведінка обвинуваченого)",
        "support_status": null
      },
      {
        "id": "P29",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "позитивно характеризується за місцем проживання,",
          "paragraph_id": 22,
          "start_char": null,
          "end_char": null
        },
        "section": "Мотиви призначення покарання (дані про особу)",
        "support_status": null
      },
      {
        "id": "P30",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "на обліках в психоневрологічному диспансері та медичному центрі превенції та терапії узалежнень не перебуває,",
          "paragraph_id": 22,
          "start_char": null,
          "end_char": null
        },
        "section": "Мотиви призначення покарання (дані про особу)",
        "support_status": null
      },
      {
        "id": "P31",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "працездатний,",
          "paragraph_id": 22,
          "start_char": null,
          "end_char": null
        },
        "section": "Мотиви призначення покарання (дані про особу)",
        "support_status": null
      },
      {
        "id": "P32",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "такі пом`якшуючі обставини та обставини, які обтяжують покарання судом не встановлені.",
          "paragraph_id": 22,
          "start_char": null,
          "end_char": null
        },
        "section": "Мотиви призначення покарання",
        "support_status": null
      },
      {
        "id": "P33",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Овинувальний акт за ч.1 та ч.2 ст.307 КК України розглядається Франківським районним судом м.Львова більш як 5 років, суждове рішенння не прийнято.",
          "paragraph_id": 23,
          "start_char": null,
          "end_char": null
        },
        "section": "Інші відомості",
        "support_status": null
      },
      {
        "id": "P34",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "в порядку ст. 100 КПК України",
          "paragraph_id": 27,
          "start_char": null,
          "end_char": null
        },
        "section": "Речові докази (нормативна підстава)",
        "support_status": null
      },
      {
        "id": "P35",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Керуючись ст. 107,370, 373, 374, 381, 382 КПК України, суд,-",
          "paragraph_id": 31,
          "start_char": null,
          "end_char": null
        },
        "section": "Оперативна частина — правові підстави",
        "support_status": null
      },
      {
        "id": "C01",
        "type": "CLAIM",
        "argumentative_role": "INTERMEDIATE_CONCLUSION",
        "source_span": {
          "text": "вина ОСОБА_3 доведена повністю",
          "paragraph_id": 21,
          "start_char": null,
          "end_char": null
        },
        "section": "Оцінка доказів та висновки",
        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "C02",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "дії обвинуваченого органом досудового слідства кваліфіковано вірно за ч.1 ст.309 КК України",
          "paragraph_id": 21,
          "start_char": null,
          "end_char": null
        },
        "section": "Правова кваліфікація",
        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "C03",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "ОСОБА_3 необхідно обрати покарання у виді обмеження волі із застосуванням ст.75, 76 КК України",
          "paragraph_id": 24,
          "start_char": null,
          "end_char": null
        },
        "section": "Мотиви призначення покарання та висновок",
        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "C04",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "суд вважає за можливим провести розгляд кримінального провадження про обвинувачення ОСОБА_3 у вчиненні кримінального проступку, передбаченого ч.1 ст.309 КК України в судовому засіданні, викликавши для участі в ньому учасників кримінального провадження для зясування обставин щодо призначення покарання.",
          "paragraph_id": 18,
          "start_char": null,
          "end_char": null
        },
        "section": "Процесуальне рішення щодо порядку розгляду",
        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "C05",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "Цивільний позов у кримінальному провадженні не заявлено.",
          "paragraph_id": 25,
          "start_char": null,
          "end_char": null
        },
        "section": "Цивільний позов",
        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "C06",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "Витрати, пов`язані із залученням експерта - покласти на ОСОБА_3 .",
          "paragraph_id": 26,
          "start_char": null,
          "end_char": null
        },
        "section": "Судові витрати",
        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "C07",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "Питання речових доказів вирішити в порядку ст. 100 КПК України.",
          "paragraph_id": 27,
          "start_char": null,
          "end_char": null
        },
        "section": "Речові докази",
        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "C09",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "Відповідно до вимог п. 3-1 ч. 2 ст. 291 КПК України, анкетні відомості викривача - відсутні.",
          "paragraph_id": 28,
          "start_char": null,
          "end_char": null
        },
        "section": "Відомості за ст. 291 КПК України",
        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "C10",
        "type": "CLAIM",
