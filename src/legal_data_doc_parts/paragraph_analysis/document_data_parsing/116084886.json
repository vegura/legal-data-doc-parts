        "id": "C08",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "Обставин, які обтяжують покарання, судом не встановлено.",
          "paragraph_id": 30,
          "start_char": null,
          "end_char": null
        },
        "section": "Мотиви призначення покарання",
        "support_status": "UNSUPPORTED_IN_TEXT"
      },
      {
        "id": "C09",
        "type": "CLAIM",
