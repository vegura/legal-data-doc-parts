        "section": "Письмові докази",
        "support_status": null
      },
      {
        "id": "P28",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "-висновком експерта №СЕ-19/113-23/4687-ТВ від 19.12.2023, відповідно якого ринкова вартість товару станом на 13.12.2023, а саме: коньяку ВС «Хеннесі», об`ємом 0,5 л, 40%, в кількості 1 шт, складає 983 грн 83 коп, пива зі смаком «Spritz & More Garage», об`ємом 0,5 л, з/б, у кількості 1 шт, складає 41 грн 03 коп, а всього на загальну суму 1024 грн 86 коп (а.с.24-28).",
          "paragraph_id": 27,
          "start_char": null,
          "end_char": null
        },
        "section": "Висновок експерта",
        "support_status": null
      },
