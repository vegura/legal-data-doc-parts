      },
      {
        "id": "C09",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "Цивільний позов у кримінальному проваджені не заявлявся.",
          "paragraph_id": 28,
          "start_char": null,
          "end_char": null
        },
