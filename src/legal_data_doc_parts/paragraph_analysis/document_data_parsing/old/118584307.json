        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "C07",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "чим спричинив потерпілому ОСОБА_6 матеріальної шкоди на загальну суму 3700 гривень.",
