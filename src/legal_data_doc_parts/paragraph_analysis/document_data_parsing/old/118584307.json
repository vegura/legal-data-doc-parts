      },
      {
        "id": "C10",
        "type": "CLAIM",
        "argumentative_role": "INTERMEDIATE_CONCLUSION",
        "source_span": {
          "text": "Згідно статті 67 КК України обставин, що обтяжують покарання  ОСОБА_4 не встановлено.",
          "paragraph_id": 44,
          "start_char": null,
