      },
      {
        "id": "C07",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "розглянув провадження за правилами, передбаченими ч. 3 ст. 349 КПК України.",
