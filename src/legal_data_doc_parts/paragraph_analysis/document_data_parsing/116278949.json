      },
      {
        "id": "P12",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "ОСОБА_4 з місця вчинення кримінального правопорушення зник",
          "paragraph_id": 21,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
