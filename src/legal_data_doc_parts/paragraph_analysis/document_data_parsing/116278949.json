        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "вартість якого згідно висновку судово-товарознавчої експертизи складає 4735 гривень.",
          "paragraph_id": 20,
          "start_char": null,
