    "components": [
      {
        "id": "P01",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Обвинувачений ОСОБА_3 , 31.12.2023 о 18:00 год, перебуваючи у приміщенні квартири АДРЕСА_2 , на грунті раптово виниклих неприязних відносин, під час словесного конфлікту з ОСОБА_4 , реалізовуючи свій протиправний умисел, спрямований на спричинення тілесних ушкоджень, умисно наніс декілька ударів кулаками обох рук по обличчю та тілу ОСОБА_4 , внаслідок чого заподіяв потерпілій тілесні ушкодження у вигляді садна на нижній повіці правого ока, синця на тильній поверхні правої кисті, синця в правій поперековій ділянці, які по тяжкості відносяться до легкого тілесного ушкодження.",
          "paragraph_id": 12,
          "start_char": null,
          "end_char": null
        },
        "section": "Встановлені судом обставини",
        "support_status": null
      },
      {
        "id": "P02",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "що складений прокурором, який звернувся до суду з клопотанням про його розгляд у спрощененому провадженні,",
          "paragraph_id": 13,
          "start_char": null,
          "end_char": null
        },
        "section": "Процесуальні підстави (спрощене провадження)",
        "support_status": null
      },
      {
        "id": "P03",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "не оспорюються обвинуваченим, про що ним подана відповідна заява за участю захисника.",
          "paragraph_id": 13,
          "start_char": null,
          "end_char": null
        },
        "section": "Процесуальні підстави (спрощене провадження)",
        "support_status": null
      },
      {
        "id": "P04",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Потерпіла також не заперечила щодо розгляду кримінального провадження у спрощеному провадженні, про що нею подана відповідна заява.",
          "paragraph_id": 14,
          "start_char": null,
          "end_char": null
        },
        "section": "Процесуальні підстави (спрощене провадження)",
        "support_status": null
      },
      {
        "id": "P05",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "У своїх заявах обвинувачений та потерпіла вказали, що обізнані із обмеженням права апеляційного оскарження згідно із ч. 2 ст. 302 КПК України.",
          "paragraph_id": 15,
          "start_char": null,
          "end_char": null
        },
        "section": "Процесуальні підстави (спрощене провадження)",
        "support_status": null
      },
      {
        "id": "P06",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "ч. 1 ст. 125 КК України.",
          "paragraph_id": 16,
          "start_char": null,
          "end_char": null
        },
        "section": "Правова кваліфікація (норма права)",
        "support_status": null
      },
      {
        "id": "C01",
        "type": "CLAIM",
        "argumentative_role": "INTERMEDIATE_CONCLUSION",
        "source_span": {
          "text": "Таким чином,  ОСОБА_3 вчинивумисне легке тілесне ушкодження, тобто кримінальний проступок, передбачений ч. 1 ст. 125 КК України.",
          "paragraph_id": 16,
          "start_char": null,
          "end_char": null
        },
        "section": "Правова кваліфікація",
        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "P07",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Обираючи вид покарання обвинуваченому, суд враховує тяжкість вчиненого діяння, що є кримінальним проступком.",
          "paragraph_id": 17,
          "start_char": null,
          "end_char": null
        },
        "section": "Мотиви призначення покарання",
        "support_status": null
      },
      {
        "id": "P08",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Враховується й особа обвинуваченого, що є людиною молодого віку, не працює, не перебуває на обліку у лікарів психіатра та нарколога, раніше не судимий.",
          "paragraph_id": 18,
          "start_char": null,
          "end_char": null
        },
        "section": "Мотиви призначення покарання",
        "support_status": null
      },
      {
        "id": "P09",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Обставиною, що пом`якшує покарання обвинуваченого, є щире каяття та активне сприяння розкриттю кримінального правопорушення.",
          "paragraph_id": 19,
          "start_char": null,
          "end_char": null
        },
        "section": "Мотиви призначення покарання",
        "support_status": null
      },
      {
        "id": "P10",
        "type": "PREMISE",
        "argumentative_role": "BASE_PREMISE",
        "source_span": {
          "text": "Обставиною, що обтяжує покарання обвинуваченому, є вчинення кримінального правопорушення щодо колишнього подружжя.",
          "paragraph_id": 20,
          "start_char": null,
          "end_char": null
        },
        "section": "Мотиви призначення покарання",
        "support_status": null
      },
      {
        "id": "C02",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "За таких обставин у їх сукупності суд вважає, що з метою кари і виправлення обвинуваченого, запобігання вчинення ним нових злочинів, необхідним та достатнім покарання для нього буде покарання у виді штрафу.",
          "paragraph_id": 21,
          "start_char": null,
          "end_char": null
        },
        "section": "Мотиви призначення покарання",
        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "C03",
        "type": "CLAIM",
        "argumentative_role": "FINAL_CONCLUSION",
        "source_span": {
          "text": "Процесуальних витрат у даному кримінальному провадженні немає,",
          "paragraph_id": 22,
          "start_char": null,
          "end_char": null
        },
