        "section": "Мотиви призначення покарання",
        "support_status": "SUPPORTED_IN_TEXT"
      },
      {
        "id": "C06",
        "type": "CLAIM",
        "argumentative_role": "INTERMEDIATE_CONCLUSION",
        "source_span": {
          "text": "Пом`якшуючими обставинами суд визнає щире каяття, активне сприяння розкриттю правопорушення.",
          "paragraph_id": 25,
          "start_char": null,
          "end_char": null
